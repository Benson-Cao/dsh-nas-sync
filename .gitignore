node_modules/
*.log
.DS_Store
Thumbs.db

# NOTE: dist/ is intentionally NOT ignored.
# This package is distributed as a git dependency (no npm registry entry), and
# pnpm/npm do not run `prepublishOnly`/`build` for git dependencies. The compiled
# bundle must ship in the repository, otherwise `main: dist/index.js` cannot
# resolve and the plugin fails to load.

# Never commit credentials or sync artefacts
.env
.credentials.yaml
*.token
*.part*
*.chunk-manifest.json
*.base

# 测试构建产物（node scripts/build-test.mjs 可重建）
dist-test/
